<Window x:Class="YtDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YT Downloader" Height="640" Width="700"
        MinHeight="560" MinWidth="580"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Border Margin="16" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="YT Downloader" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="yt-dlp auto-updates on launch. Drag any video link (YouTube, Twitter/X, TikTok, Bilibili, Vimeo, …) into the box below to auto-download."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,14" TextWrapping="Wrap"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Video URL  (drop any link here — yt-dlp supports 1000+ sites)"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <CheckBox Grid.Column="1" x:Name="TopmostCheck"
                          Content="Always on top" FontSize="12"
                          IsChecked="True"
                          Foreground="{StaticResource MutedBrush}"
                          Checked="TopmostCheck_Changed" Unchecked="TopmostCheck_Changed"/>
            </Grid>
            <TextBox Grid.Row="3" x:Name="UrlBox" Margin="0,4,0,10"
                     AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop"/>

            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Quality" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox x:Name="QualityBox" Margin="0,4,0,0" SelectedIndex="3">
                        <ComboBoxItem Content="Best"/>
                        <ComboBoxItem Content="2160p"/>
                        <ComboBoxItem Content="1440p"/>
                        <ComboBoxItem Content="1080p"/>
                        <ComboBoxItem Content="720p"/>
                        <ComboBoxItem Content="480p"/>
                        <ComboBoxItem Content="360p"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="AudioOnlyCheck" Content="Audio only (MP3)"
                          VerticalAlignment="Bottom" Margin="16,0,0,6"/>
            </Grid>

            <TextBlock Grid.Row="5" Text="Sign-in source (for restricted videos)"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <ComboBox Grid.Row="6" x:Name="BrowserBox" Margin="0,4,0,10" SelectedIndex="0">
                <ComboBoxItem Content="(none)"/>
                <ComboBoxItem Content="chrome"/>
                <ComboBoxItem Content="edge"/>
                <ComboBoxItem Content="firefox"/>
                <ComboBoxItem Content="brave"/>
                <ComboBoxItem Content="opera"/>
                <ComboBoxItem Content="vivaldi"/>
                <ComboBoxItem Content="chromium"/>
            </ComboBox>

            <TextBlock Grid.Row="7" Text="Save to" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <Grid Grid.Row="8" Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveDirBox"/>
                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                        Background="{StaticResource SoftBgBrush}"
                        Foreground="{StaticResource TextBrush}"
                        Click="BrowseClick"/>
            </Grid>

            <Grid Grid.Row="9" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DownloadBtn" Content="Download" Click="DownloadClick"
                        Height="38" Margin="0,0,4,0"/>
                <Button Grid.Column="1" x:Name="FromBrowserBtn"
                        Content="Grab from browser" Click="FromBrowserClick"
                        Height="38" Margin="4,0,0,0"
                        Background="{StaticResource SecondaryBrush}"
                        Foreground="White"/>
            </Grid>

            <ProgressBar Grid.Row="10" x:Name="Progress" Height="10" Minimum="0" Maximum="100"
                         Background="{StaticResource SoftBgBrush}"
                         Foreground="{StaticResource AccentBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>
            <TextBlock Grid.Row="11" x:Name="StatusText" Text="Ready." Margin="0,8,0,8"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>

            <TextBox Grid.Row="12" x:Name="LogBox" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     FontFamily="Consolas, Microsoft YaHei UI, Microsoft JhengHei UI, Yu Gothic UI, Malgun Gothic, Segoe UI"
                     FontSize="11"
                     Background="{StaticResource SoftBgBrush}"
                     MinHeight="120"/>
        </Grid>
    </Border>
</Window>
